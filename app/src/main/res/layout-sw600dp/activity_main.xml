<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- Tab strip -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingEnd="4dp" android:background="@color/panel">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_fox" android:contentDescription="DevxyzBrowser" />
        <HorizontalScrollView android:id="@+id/tabScroller" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="false"
            android:scrollbars="none" android:layout_marginStart="6dp">
            <LinearLayout android:id="@+id/tabStrip" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView android:id="@+id/newTab" android:layout_width="40dp" android:layout_height="match_parent"
            android:gravity="center" android:text="+" android:textSize="24sp" android:textColor="@color/text"
            android:contentDescription="New tab" android:clickable="true" android:focusable="true" />
        <ImageButton android:id="@+id/menu" android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_menu" app:tint="@color/text"
            android:background="@android:color/transparent" android:contentDescription="Browser menu" />
    </LinearLayout>

    <!-- Toolbar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="8dp"
        android:background="@color/panel">
        <ImageButton android:id="@+id/back" android:layout_width="40dp" android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back" app:tint="@color/muted"
            android:contentDescription="Back" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/forward" android:layout_width="40dp" android:layout_height="44dp"
            android:src="@drawable/ic_tb_forward" app:tint="@color/muted"
            android:contentDescription="Forward" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/refresh" android:layout_width="40dp" android:layout_height="44dp"
            android:src="@android:drawable/ic_popup_sync" app:tint="@color/muted"
            android:contentDescription="Reload" android:background="@android:color/transparent" />
        <EditText android:id="@+id/address" android:layout_width="0dp" android:layout_height="42dp"
            android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true"
            android:imeOptions="actionGo" android:inputType="textUri" android:selectAllOnFocus="true"
            android:hint="Search with Devxyz or enter address" android:textColor="@color/text"
            android:textColorHint="@color/muted" android:textSize="14sp"
            android:background="@drawable/search_bg" />
        <LinearLayout android:id="@+id/vpn_chip" android:layout_width="wrap_content" android:layout_height="38dp"
            android:layout_marginStart="8dp" android:background="@drawable/toolbar_chip_bg"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="12dp" android:paddingEnd="14dp"
            android:clickable="true" android:focusable="true" android:contentDescription="Open VPN panel">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_feat_shield" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="VPN"
                android:textColor="@color/purple2" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <ImageButton android:id="@+id/ext_toolbar" android:layout_width="40dp" android:layout_height="44dp"
            android:src="@drawable/ic_extension_puzzle"
            android:contentDescription="Extensions" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/dl_toolbar" android:layout_width="38dp" android:layout_height="44dp"
            android:src="@drawable/ic_nav_download" app:tint="@color/muted"
            android:contentDescription="Downloads" android:background="@android:color/transparent" />
        <ImageView android:id="@+id/profile_btn" android:layout_width="34dp" android:layout_height="34dp"
            android:layout_marginStart="4dp" android:src="@drawable/ic_profile_avatar"
            android:contentDescription="Profile" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <ProgressBar android:id="@+id/pageProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:max="100"
        android:progressTint="@color/purple2" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Sidebar rail -->
        <LinearLayout android:id="@+id/sidebar" android:layout_width="88dp" android:layout_height="match_parent"
            android:orientation="vertical" android:background="@color/panel" android:paddingTop="10dp">
            <LinearLayout android:id="@+id/home" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:clickable="true" android:focusable="true" android:contentDescription="Home">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_home" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Home" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bookmarks" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:clickable="true" android:focusable="true" android:contentDescription="Bookmarks">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_bookmark" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Bookmarks" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:clickable="true" android:focusable="true" android:contentDescription="History">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_history" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="History" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/downloads" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:clickable="true" android:focusable="true" android:contentDescription="Downloads">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_download" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Downloads" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/extensions" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:clickable="true" android:focusable="true" android:contentDescription="Extensions">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_extension_puzzle" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Extensions" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/vpn" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:clickable="true" android:focusable="true" android:contentDescription="VPN">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_feat_shield" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="VPN" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/settings" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:clickable="true" android:focusable="true" android:contentDescription="Settings">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_gear" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Settings" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Content -->
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <org.mozilla.geckoview.GeckoView android:id="@+id/gecko" android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <FrameLayout android:id="@+id/startPageWrap" android:layout_width="match_parent" android:layout_height="match_parent">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/bg_home_mountains" android:scaleType="centerCrop"
                    android:contentDescription="@null" />
                <ScrollView android:id="@+id/startPage" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:fillViewport="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center_horizontal"
                        android:paddingStart="32dp" android:paddingEnd="32dp"
                        android:paddingTop="40dp" android:paddingBottom="32dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center">
                            <ImageView android:layout_width="44dp" android:layout_height="44dp"
                                android:src="@drawable/ic_fox" android:background="@drawable/rounded_28"
                                android:clipToOutline="true" android:scaleType="centerCrop"
                                android:contentDescription="DevxyzBrowser logo" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="12dp" android:text="Devxyz"
                                android:textColor="@color/text" android:textStyle="bold" android:textSize="26sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Browser" android:textColor="@color/purple2"
                                android:textStyle="bold" android:textSize="26sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="30dp" android:orientation="horizontal" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Devxyz" android:textColor="@color/text"
                                android:textStyle="bold" android:textSize="44sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Browser" android:textColor="@color/purple2"
                                android:textStyle="bold" android:textSize="44sp" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:gravity="center"
                            android:text="Browse Freely. Securely. Your Way."
                            android:textColor="@color/muted" android:textSize="16sp" />
                        <EditText android:id="@+id/heroSearch" android:layout_width="match_parent" android:layout_height="56dp"
                            android:layout_marginTop="26dp" android:maxWidth="640dp" android:singleLine="true"
                            android:imeOptions="actionSearch" android:inputType="text"
                            android:hint="Search the web privately..." android:textColor="@color/text"
                            android:textColorHint="@color/muted" android:paddingStart="20dp" android:paddingEnd="20dp"
                            android:background="@drawable/search_bg"
                            android:drawableStart="@drawable/ic_tb_search" android:drawablePadding="12dp" />
                        <LinearLayout android:id="@+id/tileRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="28dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                                <ImageView android:id="@+id/siteYoutube" android:layout_width="56dp" android:layout_height="56dp"
                                    android:src="@drawable/ic_brand_youtube" android:background="@drawable/shortcut_bg"
                                    android:padding="13dp" android:clickable="true" android:focusable="true"
                                    android:contentDescription="YouTube" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="YouTube" android:textColor="@color/muted" android:textSize="11sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                                <ImageView android:id="@+id/siteFacebook" android:layout_width="56dp" android:layout_height="56dp"
                                    android:src="@drawable/ic_brand_facebook" android:background="@drawable/shortcut_bg"
                                    android:padding="13dp" android:clickable="true" android:focusable="true"
                                    android:contentDescription="Facebook" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Facebook" android:textColor="@color/muted" android:textSize="11sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                                <ImageView android:id="@+id/siteGithub" android:layout_width="56dp" android:layout_height="56dp"
                                    android:src="@drawable/ic_brand_github" android:background="@drawable/shortcut_bg"
                                    android:padding="13dp" android:clickable="true" android:focusable="true"
                                    android:contentDescription="GitHub" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="GitHub" android:textColor="@color/muted" android:textSize="11sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                                <ImageView android:id="@+id/siteReddit" android:layout_width="56dp" android:layout_height="56dp"
                                    android:src="@drawable/ic_brand_reddit" android:background="@drawable/shortcut_bg"
                                    android:padding="13dp" android:clickable="true" android:focusable="true"
                                    android:contentDescription="Reddit" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Reddit" android:textColor="@color/muted" android:textSize="11sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                                <ImageView android:id="@+id/siteX" android:layout_width="56dp" android:layout_height="56dp"
                                    android:src="@drawable/ic_brand_x" android:background="@drawable/shortcut_bg"
                                    android:padding="15dp" android:clickable="true" android:focusable="true"
                                    android:contentDescription="X" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="X" android:textColor="@color/muted" android:textSize="11sp" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                                <ImageView android:id="@+id/addSite" android:layout_width="56dp" android:layout_height="56dp"
                                    android:src="@drawable/ic_plus" android:background="@drawable/shortcut_bg"
                                    android:padding="15dp" android:clickable="true" android:focusable="true"
                                    android:contentDescription="Add site" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Add site" android:textColor="@color/muted" android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </FrameLayout>

        <!-- Right panels -->
        <ScrollView android:id="@+id/right_panels" android:layout_width="348dp" android:layout_height="match_parent"
            android:fillViewport="false" android:visibility="gone"
            android:padding="10dp" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <include android:id="@+id/vpn_panel_root" layout="@layout/panel_vpn"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:visibility="gone" />
                <Space android:id="@+id/panels_gap" android:layout_width="match_parent" android:layout_height="10dp"
                    android:visibility="gone" />
                <include android:id="@+id/ext_panel_root" layout="@layout/panel_extensions"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
