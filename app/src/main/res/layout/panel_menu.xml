<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp" android:layout_height="wrap_content">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/card_bg"
    android:paddingTop="8dp" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center"
        android:paddingTop="8dp" android:paddingBottom="12dp">
        <ImageButton android:id="@+id/m_back" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginHorizontal="2dp" android:src="@drawable/ic_arrow_back"
            app:tint="@color/text" android:background="@drawable/circle_btn_bg"
            android:padding="11dp" android:contentDescription="Back" />
        <ImageButton android:id="@+id/m_forward" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginHorizontal="2dp" android:src="@drawable/ic_tb_forward"
            app:tint="@color/text" android:background="@drawable/circle_btn_bg"
            android:padding="11dp" android:contentDescription="Forward" />
        <ImageButton android:id="@+id/m_bookmark" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginHorizontal="2dp" android:src="@drawable/ic_star"
            app:tint="@color/text" android:background="@drawable/circle_btn_bg"
            android:padding="11dp" android:contentDescription="Bookmark this page" />
        <ImageButton android:id="@+id/m_download" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginHorizontal="2dp" android:src="@drawable/ic_nav_download"
            app:tint="@color/text" android:background="@drawable/circle_btn_bg"
            android:padding="11dp" android:contentDescription="Download" />
        <ImageButton android:id="@+id/m_refresh" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginHorizontal="2dp" android:src="@drawable/ic_refresh"
            app:tint="@color/text" android:background="@drawable/circle_btn_bg"
            android:padding="11dp" android:contentDescription="Refresh" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke" android:layout_marginVertical="4dp" />

    <LinearLayout android:id="@+id/m_newtab" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_new_tab" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="New tab"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_incognito" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_incognito" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="New Incognito tab"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke" android:layout_marginVertical="4dp" />

    <LinearLayout android:id="@+id/m_history" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_nav_history" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="History"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_cleardata" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_trash" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Delete browsing data"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_site" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_site" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Site controls"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke" android:layout_marginVertical="4dp" />

    <LinearLayout android:id="@+id/m_downloads" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_nav_download" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Downloads"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_bookmarks" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_star" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Bookmarks"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_recent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_recent" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Recent tabs"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke" android:layout_marginVertical="4dp" />

    <LinearLayout android:id="@+id/m_share" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_share" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Share..."
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_find" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_find" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Find in page"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_translate" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_translate" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Translate..."
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_desktop" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_desktop" app:tint="@color/text" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="18dp" android:text="Desktop site"
            android:textColor="@color/text" android:textSize="14sp" />
        <CheckBox android:id="@+id/m_desktop_check" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:clickable="false" android:focusable="false" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke" android:layout_marginVertical="4dp" />

    <LinearLayout android:id="@+id/m_extensions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_extension_puzzle" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Extensions"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_ai" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_ai_sparkle" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Devxyz AI"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_vpn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_feat_shield" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="VPN"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/stroke" android:layout_marginVertical="4dp" />

    <LinearLayout android:id="@+id/m_settings" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_nav_gear" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Settings"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/m_help" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="18dp" android:paddingVertical="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_help" app:tint="@color/text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Help &amp; feedback"
            android:textColor="@color/text" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
