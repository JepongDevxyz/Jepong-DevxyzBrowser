<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:background="@drawable/toast_bg"
    android:paddingStart="12dp" android:paddingEnd="18dp"
    android:paddingTop="10dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="26dp" android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/devxyz_launcher_foreground"
            android:contentDescription="@null" />
        <TextView android:id="@+id/toast_text"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="14sp"
            android:maxLines="3" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Powered by Jepong Devxyz"
        android:textColor="#888888" android:textSize="10sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
