<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browserRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- Browser tab strip -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:background="@color/panel">
        <HorizontalScrollView android:id="@+id/tabScroller" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:fillViewport="false"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/tabStrip" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView android:id="@+id/newTab" android:layout_width="38dp" android:layout_height="match_parent"
            android:gravity="center" android:text="+" android:textSize="25sp" android:textColor="@color/text"
            android:contentDescription="New tab" android:clickable="true" android:focusable="true" />
        <View android:id="@+id/tabSpacer" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:visibility="gone" />
        <LinearLayout android:id="@+id/windowControls" android:layout_width="132dp" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageButton android:id="@+id/windowMinimize" android:layout_width="44dp" android:layout_height="match_parent" android:src="@drawable/ic_window_minimize" android:contentDescription="Minimize DevxyzBrowser" android:background="@android:color/transparent" />
            <ImageButton android:id="@+id/windowMaximize" android:layout_width="44dp" android:layout_height="match_parent" android:src="@drawable/ic_window_maximize" android:contentDescription="Toggle fullscreen" android:background="@android:color/transparent" />
            <ImageButton android:id="@+id/windowClose" android:layout_width="44dp" android:layout_height="match_parent" android:src="@drawable/ic_window_close" android:contentDescription="Close DevxyzBrowser" android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation and address controls -->
    <LinearLayout android:id="@+id/navigationToolbar" android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="6dp" android:paddingEnd="8dp"
        android:background="@color/panel">
        <ImageButton android:id="@+id/back" android:layout_width="36dp" android:layout_height="42dp"
            android:src="@drawable/ic_arrow_back" app:tint="@color/muted"
            android:contentDescription="Back" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/forward" android:layout_width="36dp" android:layout_height="42dp"
            android:src="@drawable/ic_forward" app:tint="@color/muted"
            android:contentDescription="Forward" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/refresh" android:layout_width="36dp" android:layout_height="42dp"
            android:src="@drawable/ic_refresh" app:tint="@color/muted"
            android:contentDescription="Reload" android:background="@android:color/transparent" />
        <EditText android:id="@+id/address" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:paddingHorizontal="13dp" android:singleLine="true"
            android:imeOptions="actionGo" android:inputType="textUri" android:selectAllOnFocus="true"
            android:hint="Search with Devxyz or enter address" android:textColor="@color/text"
            android:textColorHint="@color/muted" android:background="@drawable/search_bg" />
        <TextView android:id="@+id/vpn" android:layout_width="44dp" android:layout_height="40dp"
            android:gravity="center" android:text="VPN" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/purple2" android:background="@drawable/toolbar_chip_bg"
            android:contentDescription="Open VPN" android:clickable="true" android:focusable="true" />
        <ImageButton android:id="@+id/extensions" android:layout_width="36dp" android:layout_height="40dp"
            android:src="@drawable/ic_extension_puzzle"
            android:contentDescription="Extensions" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/toolbarDownloads" android:layout_width="36dp" android:layout_height="40dp"
            android:src="@drawable/ic_download" app:tint="@color/text"
            android:contentDescription="Downloads" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/profile" android:layout_width="36dp" android:layout_height="40dp"
            android:src="@drawable/ic_profile" app:tint="@color/purple2"
            android:contentDescription="Profile" android:background="@android:color/transparent" />
        <ImageButton android:id="@+id/menu" android:layout_width="36dp" android:layout_height="40dp"
            android:src="@drawable/ic_menu" app:tint="@color/text"
            android:background="@android:color/transparent" android:contentDescription="Browser menu" />
    </LinearLayout>
    <ProgressBar android:id="@+id/pageProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:max="100"
        android:progressTint="@color/purple2" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <LinearLayout android:id="@+id/tabletRail" android:layout_width="176dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@color/panel" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/devxyz_brandmark" android:contentDescription="DevxyzBrowser logo" />
            <TextView android:id="@+id/railBrandTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="DevxyzBrowser" android:textColor="@color/text" android:textStyle="bold" android:textSize="15sp" />
        </LinearLayout>
        <TextView android:id="@+id/railHome" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_home_active" android:drawablePadding="12dp" android:paddingStart="12dp" android:text="Home" android:textColor="@color/purple2" android:textSize="14sp" android:clickable="true" android:focusable="true" android:background="@drawable/toolbar_chip_bg" />
        <TextView android:id="@+id/railBookmarks" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_bookmark" android:drawablePadding="12dp" android:paddingStart="12dp" android:text="Bookmarks" android:textColor="@color/muted" android:textSize="14sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/railHistory" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_history" android:drawablePadding="12dp" android:paddingStart="12dp" android:text="History" android:textColor="@color/muted" android:textSize="14sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/railDownloads" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_download" android:drawablePadding="12dp" android:paddingStart="12dp" android:text="Downloads" android:textColor="@color/muted" android:textSize="14sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/railExtensions" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_extension" android:drawablePadding="12dp" android:paddingStart="12dp" android:text="Extensions" android:textColor="@color/muted" android:textSize="14sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/railVpn" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_shield" android:drawablePadding="12dp" android:paddingStart="12dp" android:text="VPN" android:textColor="@color/muted" android:textSize="14sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/railSettings" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_settings" android:drawablePadding="12dp" android:paddingStart="12dp" android:text="Settings" android:textColor="@color/muted" android:textSize="14sp" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <org.mozilla.geckoview.GeckoView android:id="@+id/gecko" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ScrollView android:id="@+id/startPage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/home_backdrop">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="42dp" android:paddingBottom="24dp">
                <LinearLayout android:id="@+id/homeBrandLockup" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/devxyz_brandmark" android:contentDescription="DevxyzBrowser" />
                    <TextView android:id="@+id/brandTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:gravity="center" android:text="DevxyzBrowser" android:textColor="@color/text" android:textStyle="bold" android:textSize="17sp" />
                </LinearLayout>
                <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="41dp"
                    android:gravity="center" android:text="Browse Freely.\nSecurely. Your Way."
                    android:textColor="@color/text" android:textStyle="bold" android:textSize="34sp" />
                <TextView android:id="@+id/desktopHomeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                    android:text="DevxyzBrowser" android:textColor="@color/text" android:textStyle="bold" android:textSize="37sp" android:visibility="gone" />
                <TextView android:id="@+id/desktopHomeSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center"
                    android:text="Browse Freely. Securely. Your Way." android:textColor="@color/muted" android:textSize="15sp" android:visibility="gone" />
                <TextView android:id="@+id/heroSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:gravity="center" android:text="Fast. Private. Flexible."
                    android:textColor="@color/muted" android:textSize="17sp" />
                <EditText android:id="@+id/heroSearch" android:layout_width="match_parent" android:layout_height="54dp"
                    android:layout_marginTop="28dp" android:maxWidth="560dp" android:singleLine="true"
                    android:imeOptions="actionSearch" android:inputType="text" android:hint="⌕   Search the web privately..."
                    android:paddingHorizontal="20dp" android:textColor="@color/text" android:textColorHint="@color/muted"
                    android:background="@drawable/search_bg" />
                <HorizontalScrollView android:id="@+id/quickSites" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="30dp" android:scrollbars="none" android:overScrollMode="never">
                    <LinearLayout android:id="@+id/quickSiteStrip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="60dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageButton android:id="@+id/siteYoutube" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/shortcut_youtube" android:scaleType="fitCenter" android:background="@android:color/transparent" android:contentDescription="Open YouTube" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="YouTube" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="60dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageButton android:id="@+id/siteFacebook" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/shortcut_facebook" android:scaleType="fitCenter" android:background="@android:color/transparent" android:contentDescription="Open Facebook" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Facebook" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="60dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageButton android:id="@+id/siteGithub" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/shortcut_github" android:scaleType="fitCenter" android:background="@android:color/transparent" android:contentDescription="Open GitHub" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="GitHub" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="60dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageButton android:id="@+id/siteReddit" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/shortcut_reddit" android:scaleType="fitCenter" android:background="@android:color/transparent" android:contentDescription="Open Reddit" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Reddit" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="60dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                        <ImageButton android:id="@+id/siteX" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/shortcut_x" android:scaleType="fitCenter" android:background="@android:color/transparent" android:contentDescription="Open X" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="X" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="60dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageButton android:id="@+id/addSite" android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/shortcut_add" android:scaleType="fitCenter" android:background="@android:color/transparent" android:contentDescription="Add a site" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Add site" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                    android:orientation="vertical">
                    <LinearLayout android:id="@+id/phoneVpnCard" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="16dp" android:orientation="vertical" android:background="@drawable/panel_bg">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="♢  VPN" android:textColor="@color/text" android:textStyle="bold" android:textSize="17sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OPENVPN" android:textColor="@color/purple2" android:textSize="11sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:id="@+id/vpnStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp"
                            android:text="Disconnected • No profile imported" android:textColor="@color/muted" android:textSize="13sp" />
                        <Button android:id="@+id/vpnPanel" android:layout_width="match_parent" android:layout_height="46dp"
                            android:layout_marginTop="12dp" android:text="Set up VPN" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/text" android:background="@drawable/accent_bg" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/phoneExtensionsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:padding="16dp" android:orientation="vertical" android:background="@drawable/panel_bg">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✣  Extensions" android:textColor="@color/text" android:textStyle="bold" android:textSize="17sp" />
                        <TextView android:id="@+id/mobileExtensionSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:text="Loading installed add-ons…" android:textColor="@color/muted" android:textSize="13sp" />
                        <Button android:id="@+id/extensionsPanel" android:layout_width="match_parent" android:layout_height="46dp"
                            android:layout_marginTop="12dp" android:text="Manage extensions" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/text" android:background="@drawable/toolbar_chip_bg" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <LinearLayout android:id="@+id/desktopPanels" android:layout_width="574dp" android:layout_height="match_parent" android:orientation="horizontal" android:padding="0dp" android:background="@color/bg" android:visibility="gone">
        <LinearLayout android:id="@+id/desktopVpnPanel" android:layout_width="284dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/panel_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="VPN" android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp" />
                <TextView android:id="@+id/vpnSettings" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="⚙" android:textColor="@color/muted" android:clickable="true" android:focusable="true" android:contentDescription="VPN settings" />
            </LinearLayout>
            <ImageView android:id="@+id/desktopVpnMap" android:layout_width="match_parent" android:layout_height="128dp" android:layout_marginTop="8dp" android:scaleType="fitCenter" android:src="@drawable/vpn_world_power" android:contentDescription="VPN connection control over world map" android:clickable="true" />
            <TextView android:id="@+id/desktopVpnStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Disconnected" android:textColor="@color/muted" android:textSize="13sp" />
            <LinearLayout android:id="@+id/vpnProfileSelector" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:paddingHorizontal="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/toolbar_chip_bg" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="◎" android:textColor="@color/purple2" android:textSize="20sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/vpnProfileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No profile imported" android:textColor="@color/text" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/vpnProfileSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose your OpenVPN server" android:textColor="@color/muted" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:text="⌄" android:textColor="@color/muted" android:textSize="17sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="@color/stroke" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Auto Connect" android:textColor="@color/text" android:textSize="12sp" />
        <Switch android:id="@+id/autoConnect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb" android:trackTint="@color/switch_track" android:contentDescription="Automatically connect when a saved profile is ready" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal" android:clickable="true" android:focusable="true" android:id="@+id/killSwitchSettings">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kill Switch" android:textColor="@color/text" android:textSize="12sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Configure in Android Settings  ›" android:textColor="@color/purple2" android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Block Trackers" android:textColor="@color/text" android:textSize="12sp" />
                <Switch android:id="@+id/blockTrackers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="@color/switch_thumb" android:trackTint="@color/switch_track" android:contentDescription="Block web trackers" />
            </LinearLayout>
            <TextView android:id="@+id/vpnSecureCard" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:padding="8dp" android:text="◇  Import a VPN profile to connect" android:textColor="@color/muted" android:textSize="10sp" android:background="@drawable/toolbar_chip_bg" />
            <Button android:id="@+id/desktopVpnAction" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" android:importantForAccessibility="no" android:text="Set up VPN" />
        </LinearLayout>
        <LinearLayout android:id="@+id/desktopExtensionsPane" android:layout_width="278dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/panel_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Extensions" android:textColor="@color/text" android:textStyle="bold" android:textSize="18sp" />
                <TextView android:id="@+id/extensionsClose" android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="×" android:textColor="@color/muted" android:textSize="22sp" android:clickable="true" android:focusable="true" android:contentDescription="Close extensions" />
            </LinearLayout>
            <EditText android:id="@+id/extensionSearch" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="2dp" android:layout_marginBottom="6dp" android:paddingHorizontal="12dp" android:singleLine="true" android:hint="⌕  Search extensions…" android:textColor="@color/text" android:textColorHint="@color/muted" android:textSize="12sp" android:background="@drawable/search_bg" />
            <LinearLayout android:id="@+id/desktopExtensionRows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
            <Button android:id="@+id/desktopExtensionsAction" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Browse more extensions" android:textAllCaps="false" android:textColor="@color/text" android:background="@drawable/toolbar_chip_bg" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <!-- Phone navigation; tablet/desktop rail becomes visible in layout-sw600dp -->
    <LinearLayout android:id="@+id/mobileNav" android:layout_width="match_parent" android:layout_height="58dp"
        android:gravity="center" android:orientation="horizontal" android:background="@color/panel">
        <TextView android:id="@+id/home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⌂\nHome" android:textColor="@color/purple2" android:textSize="12sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/bookmarks" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="☆\nSaved" android:textColor="@color/muted" android:textSize="12sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/history" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="◷\nHistory" android:textColor="@color/muted" android:textSize="12sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/downloads" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="↓\nDownloads" android:textColor="@color/muted" android:textSize="12sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙\nSettings" android:textColor="@color/muted" android:textSize="12sp" android:clickable="true" android:focusable="true" />
