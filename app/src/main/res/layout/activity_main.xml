<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <!-- Chrome-style toolbar: omnibox + tab count + menu (can move to bottom) -->
    <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="4dp"
        android:background="@color/panel">
        <EditText android:id="@+id/address" android:layout_width="0dp" android:layout_height="42dp"
            android:layout_weight="1" android:paddingHorizontal="14dp" android:singleLine="true"
            android:imeOptions="actionGo" android:inputType="textUri" android:selectAllOnFocus="true"
            android:hint="Search or enter address" android:textColor="@color/text"
            android:textColorHint="@color/muted" android:background="@drawable/search_bg"
            android:drawableStart="@drawable/ic_tb_search" android:drawablePadding="10dp"
            android:drawableTint="@color/muted" />
        <ImageButton android:id="@+id/toolbarShortcut" android:layout_width="42dp" android:layout_height="42dp"
            android:layout_marginStart="4dp" android:src="@drawable/ic_tb_search" app:tint="@color/text"
            android:background="@drawable/toolbar_chip_bg" android:visibility="gone"
            android:contentDescription="Toolbar shortcut" />
        <TextView android:id="@+id/tabCount" android:layout_width="42dp" android:layout_height="42dp"
            android:layout_marginStart="4dp" android:gravity="center"
            android:text="1" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text"
            android:background="@drawable/toolbar_chip_bg"
            android:contentDescription="Tabs" android:clickable="true" android:focusable="true" />
        <ImageButton android:id="@+id/menu" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_more_vert" app:tint="@color/text"
            android:background="@android:color/transparent" android:contentDescription="Browser menu" />
    </LinearLayout>
    <ProgressBar android:id="@+id/pageProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:max="100"
        android:progressTint="@color/purple2" android:visibility="gone" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <org.mozilla.geckoview.GeckoView android:id="@+id/gecko" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <FrameLayout android:id="@+id/startPageWrap" android:layout_width="match_parent" android:layout_height="match_parent">
            <ImageView android:id="@+id/home_bg"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
        <ScrollView android:id="@+id/startPage" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="24dp" android:paddingBottom="24dp">
                <ImageView android:id="@+id/ntpLogo" android:layout_width="110dp" android:layout_height="110dp"
                    android:layout_marginTop="30dp" android:contentDescription="DevxyzBrowser logo" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Devxyz" android:textColor="@color/text"
                        android:textStyle="bold" android:textSize="31sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Browser" android:textColor="@color/purple2"
                        android:textStyle="bold" android:textSize="31sp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                    android:gravity="center" android:text="Browse Freely. Securely. Your Way."
                    android:textColor="@color/muted" android:textSize="15sp" />
                <EditText android:id="@+id/heroSearch" android:layout_width="match_parent" android:layout_height="54dp"
                    android:layout_marginTop="22dp" android:maxWidth="620dp" android:singleLine="true"
                    android:imeOptions="actionSearch" android:inputType="text" android:hint="Search the web privately..."
                    android:paddingHorizontal="20dp" android:textColor="@color/text" android:textColorHint="@color/muted"
                    android:focusable="true" android:focusableInTouchMode="false"
                    android:background="@drawable/search_bg"
                    android:drawableStart="@drawable/ic_tb_search" android:drawableEnd="@drawable/ic_tb_search"
                    android:drawablePadding="12dp" android:drawableTint="@color/muted" />
                <LinearLayout android:id="@+id/quickSites" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:orientation="horizontal" android:gravity="center">
                    <LinearLayout android:id="@+id/tileRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <ImageView android:id="@+id/siteYoutube" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_youtube" android:background="@drawable/shortcut_bg" android:padding="14dp" android:clickable="true" android:focusable="true" android:contentDescription="YouTube" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="YouTube" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <ImageView android:id="@+id/siteFacebook" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_facebook" android:background="@drawable/shortcut_bg" android:padding="14dp" android:clickable="true" android:focusable="true" android:contentDescription="Facebook" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Facebook" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <ImageView android:id="@+id/siteGithub" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_github" android:background="@drawable/shortcut_bg" android:padding="14dp" android:clickable="true" android:focusable="true" android:contentDescription="GitHub" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="GitHub" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <ImageView android:id="@+id/siteReddit" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_reddit" android:background="@drawable/shortcut_bg" android:padding="14dp" android:clickable="true" android:focusable="true" android:contentDescription="Reddit" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Reddit" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <ImageView android:id="@+id/siteX" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_brand_x" android:background="@drawable/shortcut_bg" android:padding="16dp" android:clickable="true" android:focusable="true" android:contentDescription="X" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="X" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <ImageView android:id="@+id/addSite" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_plus" android:background="@drawable/shortcut_bg" android:padding="16dp" android:clickable="true" android:focusable="true" android:contentDescription="Add site" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Add site" android:textColor="@color/muted" android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        </FrameLayout>
    </FrameLayout>

    <!-- Phone navigation; tablet/desktop rail becomes visible in layout-sw600dp -->

    <!-- Bottom navigation toolbar (Brave-style Appearance option, hidden by default) -->
    <LinearLayout android:id="@+id/bottomNavBar" android:layout_width="match_parent" android:layout_height="60dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/panel" android:visibility="gone"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/bnHome" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:src="@drawable/ic_nav_home" app:tint="@color/muted"
            android:background="@android:color/transparent" android:contentDescription="Home" />
        <ImageButton android:id="@+id/bnBookmarks" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:src="@drawable/ic_nav_bookmark" app:tint="@color/muted"
            android:background="@android:color/transparent" android:contentDescription="Bookmarks" />
        <ImageButton android:id="@+id/bnSearch" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:src="@drawable/ic_tb_search" app:tint="@color/muted"
            android:background="@android:color/transparent" android:contentDescription="Search" />
        <ImageButton android:id="@+id/bnTabs" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:src="@drawable/ic_new_tab" app:tint="@color/muted"
            android:background="@android:color/transparent" android:contentDescription="Tabs" />
        <ImageButton android:id="@+id/bnMenu" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:src="@drawable/ic_more_vert" app:tint="@color/muted"
            android:background="@android:color/transparent" android:contentDescription="Menu" />
    </LinearLayout>
</LinearLayout>
