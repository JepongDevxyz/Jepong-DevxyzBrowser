<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/panel_bg"
    android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Extensions" android:textColor="@color/text"
            android:textStyle="bold" android:textSize="18sp" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:id="@+id/ext_close" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="7dp" android:src="@drawable/ic_close"
            android:contentDescription="Close extensions panel" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <EditText android:id="@+id/ext_search" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="12dp" android:background="@drawable/search_bg"
        android:hint="Search extensions..." android:textColor="@color/text"
        android:textColorHint="@color/muted" android:singleLine="true"
        android:imeOptions="actionSearch" android:inputType="text"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:drawableStart="@drawable/ic_tb_search" android:drawablePadding="10dp" />

    <TextView android:id="@+id/ext_installed_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Installed"
        android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/ext_installed_list" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView android:id="@+id/ext_recommended_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="Recommended"
        android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/ext_recommended_list" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button android:id="@+id/ext_browse_more" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="16dp" android:background="@drawable/toolbar_chip_bg"
        android:text="Browse more extensions" android:textAllCaps="false"
        android:textColor="@color/purple2" android:textSize="13sp" android:textStyle="bold"
        android:drawableStart="@drawable/ic_extension_puzzle"
        android:drawablePadding="10dp" android:gravity="center" />
</LinearLayout>
