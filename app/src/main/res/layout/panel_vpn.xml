<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/panel_bg"
    android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="VPN" android:textColor="@color/text"
            android:textStyle="bold" android:textSize="18sp" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:id="@+id/vpn_gear" android:layout_width="34dp" android:layout_height="34dp"
            android:padding="6dp" android:src="@drawable/ic_nav_gear" app:tint="@color/muted"
            android:contentDescription="VPN settings" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <ImageButton android:id="@+id/vpn_power" android:layout_width="92dp" android:layout_height="92dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="18dp"
        android:src="@drawable/ic_power" android:background="@drawable/vpn_power_bg"
        android:padding="24dp" android:contentDescription="Toggle VPN connection" />

    <TextView android:id="@+id/vpn_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center"
        android:text="Disconnected" android:textColor="@color/muted"
        android:textStyle="bold" android:textSize="15sp" />

    <LinearLayout android:id="@+id/vpn_location_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:background="@drawable/card_bg"
        android:padding="12dp" android:gravity="center_vertical"
        android:clickable="true" android:focusable="true"
        android:contentDescription="VPN location. Tap to change profile.">
        <ImageView android:layout_width="30dp" android:layout_height="30dp"
            android:src="@drawable/ic_globe" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/vpn_location_host" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="No profile" android:textColor="@color/text" android:textSize="14sp" />
            <TextView android:id="@+id/vpn_location_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Tap to import .ovpn"
                android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingTop="12dp" android:paddingBottom="12dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_nav_history" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="Auto Connect"
            android:textColor="@color/text" android:textSize="14sp" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_autoconnect"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingTop="12dp" android:paddingBottom="12dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_feat_shield" app:tint="@color/muted" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="Kill Switch"
            android:textColor="@color/text" android:textSize="14sp" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_killswitch"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingTop="12dp" android:paddingBottom="12dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_globe" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="Block Trackers"
            android:textColor="@color/text" android:textSize="14sp" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sw_blocktrackers"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/card_bg"
        android:padding="12dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/vpn_secure_icon" android:layout_width="26dp" android:layout_height="26dp"
            android:src="@drawable/ic_feat_shield" app:tint="@color/muted" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/vpn_secure_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="You're not protected" android:textColor="@color/text"
                android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/vpn_ip" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Connect to secure your connection"
                android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
