<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#17112E" android:centerColor="#0C0D21" android:endColor="#070914" />
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="460dp" android:height="340dp" android:top="-110dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="250dp" android:centerColor="#44284088" android:endColor="#00282888" />
        </shape>
    </item>
    <item android:gravity="bottom" android:drawable="@drawable/home_landscape" />
</layer-list>
