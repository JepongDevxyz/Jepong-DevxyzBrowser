<resources>
<style name="Theme.DevxyzBrowser" parent="Theme.Material3.Dark.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">false</item>
    <item name="android:navigationBarColor">@color/bg</item><item name="android:statusBarColor">@color/bg</item>
    <item name="colorPrimary">@color/purple</item>
</style>
<style name="Theme.DevxyzBrowser.Splash" parent="Theme.Material3.Dark.NoActionBar">
    <item name="android:windowBackground">@drawable/splash_window</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:statusBarColor">@color/bg</item>
    <item name="android:navigationBarColor">@color/bg</item>
</style>
<style name="Theme.DevxyzBrowser.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
    <item name="colorSurface">@color/panel</item>
    <item name="colorOnSurface">@color/text</item>
    <item name="colorOnSurfaceVariant">@color/muted</item>
    <item name="colorPrimary">@color/orange</item>
    <item name="android:textColorPrimary">@color/text</item>
    <item name="android:textColorSecondary">@color/muted</item>
    <item name="android:windowBackground">@color/panel</item>
</style>
</resources>